# Copy to ~/.wedding-planner-loop/config.env (the agent user's; never committed). The runner reads
# it as data: only the keys below, with validated values; anything else is ignored. Every line is
# optional except WP_DASHBOARD_URL, which the reporter needs. No secrets belong in this file.

# The claude.ai artifact the reporter republishes (set once, when the dashboard is first published).
WP_DASHBOARD_URL=

# Skip every role but sre once today's recorded spend (from the journal) reaches this many USD.
# WP_LOOP_DAILY_BUDGET_USD=40

# Per-role model and effort overrides (defaults in ops/loop/run-role.sh).
# WP_LOOP_MODEL_BUILDER=opus
# WP_LOOP_EFFORT_BUILDER=high
# WP_LOOP_MODEL_TRIAGE=opus

# Per-session spend caps in USD (defaults: builder 40, sre 8, triage 8, feedback 4, synthetic 8, reporter 3).
# WP_LOOP_MAX_USD_BUILDER=40
