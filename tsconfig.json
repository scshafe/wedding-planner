{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@wedding-planner/shared": ["shared/src/index.ts"],
      "@wedding-planner/shared/*": ["shared/src/*"],
      "@wedding-planner/telemetry": ["telemetry/src/index.ts"],
      "@wedding-planner/telemetry/*": ["telemetry/src/*"],
      "@wedding-planner/eval-harness": ["eval-harness/src/index.ts"],
      "@wedding-planner/eval-harness/*": ["eval-harness/src/*"],
      "@wedding-planner/loop-orchestrator": ["loop-orchestrator/src/index.ts"],
      "@wedding-planner/loop-orchestrator/*": ["loop-orchestrator/src/*"],
      "@wedding-planner/agent-operations": ["agent-operations/src/index.ts"],
      "@wedding-planner/agent-operations/*": ["agent-operations/src/*"],
      "@wedding-planner/product": ["product/src/index.ts"],
      "@wedding-planner/product/*": ["product/src/*"]
    }
  },
  "include": [
    "shared/src",
    "shared/tests",
    "telemetry/src",
    "telemetry/tests",
    "eval-harness/src",
    "eval-harness/tests",
    "loop-orchestrator/src",
    "loop-orchestrator/tests",
    "agent-operations/src",
    "agent-operations/tests",
    "product/src",
    "product/tests",
    "app",
    "scripts",
    "vitest.config.ts"
  ]
}
