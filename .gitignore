# macOS / editor noise
.DS_Store
*.swp
*~

# Local session state — not shared (lock files, machine-local notes)
*.local.md
.claude/*.lock
# EXCEPTION: the handoff IS the autonomous loop's continuation state — it must travel with the repo
# so a fresh clone (e.g. on the build server) can pick up where the last run left off. Committed.
!.claude/handoff.local.md

# Dependencies / build output (forward-looking, once implementation starts)
node_modules/
dist/
build/
coverage/
.cache/

# Logs & env
*.log
.env
.env.*
!deploy/stack/.env.example

# Keep implementation plans under version control:
# .claude/plans/ is intentionally NOT ignored.
